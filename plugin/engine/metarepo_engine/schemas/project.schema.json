{
  "$comment": "002 section 4: project.yaml schema v1. Keywords: see metarepo_engine/validate.py. Cross-field rules live in config.py.",
  "type": "object",
  "required": ["schema_version", "id", "name", "slug", "objective", "scope", "language", "toolkit"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "name": { "type": "string", "pattern": "\\S" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "objective": { "type": "string", "pattern": "\\S" },
    "scope": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "language": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
      }
    },
    "toolkit": {
      "type": "object",
      "required": ["requires"],
      "properties": {
        "requires": { "type": "string", "pattern": "\\S" },
        "created_with": { "type": "string" }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["google-drive", "onedrive", "dropbox", "none"] },
        "notes": { "type": "string" }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "url": { "type": "string", "pattern": "\\S" },
          "default_branch": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "secondary", "reference"] }
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "display_name": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "wiki_write_mode": { "type": "string", "enum": ["lease", "owner"] },
        "wiki_owners": { "type": "array", "items": { "type": "string" } },
        "lease_ttl_minutes": { "type": "integer", "minimum": 1 },
        "lease_settle_seconds": { "type": "integer", "minimum": 0 },
        "audit_expected": { "type": "boolean" }
      }
    },
    "intake": {
      "type": "object",
      "properties": {
        "confirm": { "type": "string", "enum": ["always", "when-uncertain"] },
        "auto_feed": { "type": "boolean" },
        "triage_budget_tokens": { "type": "integer", "minimum": 1 },
        "on_reject": { "type": "string", "enum": ["leave-in-inbox", "move-to-shared", "delete"] },
        "archive_bundles": { "type": "boolean" },
        "bundle_max_depth": { "type": "integer", "minimum": 0 },
        "max_source_depth": { "type": "integer", "minimum": 1 },
        "bundle_max_uncompressed_mb": { "type": "number", "minimum": 1 },
        "bundle_max_ratio": { "type": "number", "minimum": 1 },
        "categories": { "type": "array", "items": { "type": "string" } }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "allow_cloud": { "type": "boolean" },
        "preferences": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "large_table_rows": { "type": "integer", "minimum": 1 },
        "max_body_mb": { "type": "number", "minimum": 0.001 },
        "quality_thresholds": { "type": "object", "additionalProperties": true },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "media_types", "command"],
            "properties": {
              "name": { "type": "string", "pattern": "\\S" },
              "media_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "command": { "type": ["string", "array"] },
              "mode": { "type": "string", "enum": ["local", "cloud"] },
              "timeout_s": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "block_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "regex"],
            "properties": {
              "name": { "type": "string", "pattern": "\\S" },
              "regex": { "type": "string", "pattern": "\\S" },
              "description": { "type": "string" }
            }
          }
        },
        "block_terms": { "type": "array", "items": { "type": "string" } },
        "path_limit": { "type": "integer", "minimum": 40 },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["block", "error", "warn", "info"] }
        },
        "allow_policy_downgrade": { "type": "boolean" }
      }
    },
    "doctor": {
      "type": "object",
      "properties": {
        "inbox_max_age_days": { "type": "integer", "minimum": 0 },
        "large_file_mb": { "type": "number", "minimum": 1 }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "default_format": { "type": "string", "enum": ["markdown", "marp", "html"] }
      }
    },
    "extra_folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "tier"],
        "properties": {
          "path": { "type": "string", "pattern": "\\S" },
          "tier": { "type": "string", "enum": ["on-demand", "explicit"] },
          "purpose": { "type": "string" }
        }
      }
    }
  }
}
