{
  "$comment": "005: answers file for `init`. Basic interview keys first (R3), advanced keys after (R3a). Unknown keys are rejected by init.",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": { "type": "string", "pattern": "\\S" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "pattern": "\\S" },
    "notes": { "type": "string" },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "pattern": "\\S" },
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "default_branch": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "secondary", "reference"] }
        }
      }
    },
    "sync_provider": { "type": "string", "enum": ["google-drive", "onedrive", "dropbox", "none"] },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "objective": { "type": "string", "pattern": "\\S" },
    "scope": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "display_name": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "wiki_write_mode": { "type": "string", "enum": ["lease", "owner"] },
    "wiki_owners": { "type": "array", "items": { "type": "string" } },
    "intake_confirm": { "type": "string", "enum": ["always", "when-uncertain"] }
  }
}
